{
  "name": "realtimevoice",
  "version": "0.1.0",
  "private": true,
  "description": "Live church-service translation powered by OpenAI Realtime + LiveKit",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "dev:web": "pnpm --filter @rtv/web dev",
    "dev:orchestrator": "pnpm --filter @rtv/orchestrator dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
