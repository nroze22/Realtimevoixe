# --- OpenAI ---
# Required. Used for gpt-realtime-translate sessions and Whisper transcription.
OPENAI_API_KEY=sk-...
# Realtime model. Default to the May 2026 GA translation-specialized model.
OPENAI_REALTIME_MODEL=gpt-realtime-translate
# Whisper model used for source-language captions sidecar.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Once OpenAI grants Custom Voices API access, list approved voice IDs here per pastor.
# Format: <pastorId>:<openaiVoiceId>,<pastorId>:<openaiVoiceId>
OPENAI_CUSTOM_VOICE_IDS=

# --- LiveKit ---
# Sign up at https://cloud.livekit.io and create a project; copy the values from "Settings -> Keys".
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Orchestrator ---
ORCHESTRATOR_PORT=8787
ORCHESTRATOR_PUBLIC_URL=http://localhost:8787

# --- Web app ---
NEXT_PUBLIC_ORCHESTRATOR_WS_URL=ws://localhost:8787
NEXT_PUBLIC_ORCHESTRATOR_HTTP_URL=http://localhost:8787
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- Cost guardrails ---
# Hard cap per single service in USD. Sessions auto-terminate when reached.
COST_CAP_PER_SERVICE_USD=30
# Soft monthly warning threshold per org in USD. Currently logged only.
COST_CAP_PER_ORG_MONTHLY_USD=300
